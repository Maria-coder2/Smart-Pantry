<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7FA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#17324D"
        android:paddingBottom="24dp" />

    <Switch
        android:id="@+id/switchExpiryAlerts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable expiry alerts"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Control whether the app should enable expiry-related alerts."
        android:paddingTop="8dp"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Pantry" />

</LinearLayout>

